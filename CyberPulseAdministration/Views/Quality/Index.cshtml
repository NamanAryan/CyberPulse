@{
    Func<long, string> formatSize = (bytes) =>
    {
        if (bytes == 0) return "0 B";
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1) { number /= 1024; counter++; }
        return string.Format("{0:n1} {1}", number, suffixes[counter]);
    };

    // Determine active document tab from TempData (set after upload/delete)
    string activeDocTab = TempData["ActiveTab"] as string ?? "QualityManual";
    string activeMainTab = ViewBag.ActiveMainTab as string ?? "Documents";
    
    var announcements = ViewBag.Announcements as IEnumerable<CyberPulseAdministration.Models.QualityAnnouncement>;

    string mainTabHeading = activeMainTab == "Announcements" ? "Quality Announcements"
        : activeMainTab == "Certificate" ? "Quality Certificate"
        : "Quality Inside";
    string mainTabDescription = activeMainTab == "Announcements" ? "Create and manage quality announcements."
        : activeMainTab == "Certificate" ? "Manage quality certificates."
        : "Manage your Quality Core documents.";
    ViewBag.Title = mainTabHeading;
}

<style>
    /* Tab Navigation Styles (Main Tabs) */
    .main-tab-nav {
        display: flex;
        gap: 15px;
        margin-bottom: 24px;
        border-bottom: 1px solid #dee2e6;
    }
    .main-tab-btn {
        padding: 10px 20px;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        color: #6c757d;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .main-tab-btn:hover {
        color: #1565c0;
    }
    .main-tab-btn.active {
        color: #1565c0;
        border-bottom-color: #1565c0;
    }

    /* Tab Transition */
    .main-pane-content {
        display: none;
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
    }
    .main-pane-content.active {
        display: block;
        opacity: 1;
    }

    /* Document inner tabs (Original QualityInside styles) */
    .quality-tab-nav {
        display: flex;
        flex-direction: row;
        gap: 0;
        border-bottom: 2px solid #dee2e6;
        margin-bottom: 24px;
    }
    .quality-tab-btn {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 14px 10px;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        color: #1565c0;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
    }
    .quality-tab-btn i { font-size: 20px; }
    .quality-tab-btn:hover { background: #f0f4ff; }
    .quality-tab-btn.active {
        background: #1565c0;
        color: #fff;
        border-radius: 6px 6px 0 0;
        border-bottom-color: #1565c0;
    }
    .quality-tab-btn.active i { color: #fff; }

    .section-panel {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        overflow: hidden;
    }
    .section-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: #fff;
        border-bottom: 1px solid #dee2e6;
    }
    .section-panel-header h6 {
        margin: 0;
        font-weight: 700;
        font-size: 14px;
        color: #1a1a2e;
    }
    .file-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .file-table th {
        padding: 8px 12px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
    }
    .file-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
        color: #333;
    }
    .file-table tr:last-child td { border-bottom: none; }
    .file-table tr:hover td { background: #f8f9fa; }
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #aaa;
    }
    .empty-state i { font-size: 36px; display: block; margin-bottom: 8px; }
    .btn-upload-sm {
        font-size: 12px;
        padding: 5px 12px;
    }
    .tab-pane-content { display: none; }
    .tab-pane-content.active { display: block; }
</style>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1" id="sectionHeading">@mainTabHeading</h2>
        <p class="text-secondary mb-0 small" id="sectionDescription">@mainTabDescription</p>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Main Tab Navigation -->

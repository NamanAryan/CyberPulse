    <button class="main-tab-btn @(activeMainTab == "Certificate" ? "active" : "")" id="main-tab-Certificate" onclick="switchMainTab('Certificate', '@Url.Action("Certificate", "Quality")')">
        <i class="bi bi-file-earmark me-1"></i> Quality Certificate

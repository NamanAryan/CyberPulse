<!-- Main Pane: Quality Certificate -->
<div class="main-pane-content @(activeMainTab == "Certificate" ? "active" : "")" id="main-pane-Certificate">

    <!-- Hidden upload form for Quality Certificate (PDF / image only) -->
    @using (Html.BeginForm("Upload", "Quality", FormMethod.Post, new { enctype = "multipart/form-data", id = "form-QualityCertificate", style = "display:none" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="tab" value="QualityCertificate" />
        <input type="file" id="input-QualityCertificate" name="files" multiple accept=".pdf,.jpg,.jpeg,.png" onchange="if (validateCertificateFiles(this)) { this.form.submit(); }" />
    }

    @RenderSingleSection("Quality Certificate", ViewBag.CertificateFiles, "QualityCertificate", formatSize)
</div>

@helper RenderSingleSection(string title, List<CyberPulseAdministration.Controllers.QualityFile> files, string uploadKey, Func<long, string> formatSize)
{
    <div class="section-panel">
        <div class="section-panel-header">
            <h6>@title</h6>
            <button class="btn btn-primary btn-sm btn-upload-sm" onclick="document.getElementById('input-@uploadKey').click()">
                <i class="bi bi-cloud-arrow-up me-1"></i> Upload
            </button>
        </div>
        <table class="file-table">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Upload Date</th>
                    <th>Size</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (files == null || !files.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <i class="bi bi-folder2-open"></i>
                                No files uploaded yet.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var file in files)
                    {
                        var underscoreIdx = file.FileName.IndexOf('_');
                        var displayName = (underscoreIdx >= 0 && underscoreIdx == 36)
                            ? file.FileName.Substring(37)
                            : file.FileName;

                        <tr>
                            <td>
                                <a href="@Url.Action("Download", "Quality", new { tab = GetTabPath(uploadKey), fileName = file.FileName })" class="text-dark text-decoration-none" title="@displayName">
                                    @(displayName.Length > 45 ? displayName.Substring(0, 42) + "..." : displayName)
                                </a>
                            </td>
                            <td class="text-secondary">@file.UploadDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-secondary">@formatSize(file.FileSize)</td>
                            <td>
                                @using (Html.BeginForm("Delete", "Quality", new { tab = GetTabPath(uploadKey), fileName = file.FileName }, FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('Delete this file?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size:12px;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@functions {
    public static string GetTabPath(string key)
    {
        switch (key)
        {
            case "QualityManual": return "QualityManual";
            case "QualitySystemProcedure": return "QualitySystemProcedure";
            case "QualityStandard": return "QualityStandardGuidelines/QualityStandard";
            case "Guidelines": return "QualityStandardGuidelines/Guidelines";
            case "Template": return "TemplateFormChecklist/Template";
            case "Form": return "TemplateFormChecklist/Form";
            case "Checklist": return "TemplateFormChecklist/Checklist";
            case "QualityCertificate": return "QualityCertificate";
            default: return key;
        }
    }
}

@section Scripts {
<script>
    // --- Main Tab Switching (History API & Fade) ---
    var mainTabInfo = {
        'Documents': { heading: 'Quality Inside', description: 'Manage your Quality Core documents.' },
        'Announcements': { heading: 'Quality Announcements', description: 'Create and manage quality announcements.' },
        'Certificate': { heading: 'Quality Certificate', description: 'Manage quality certificates.' }
    };

    function switchMainTab(tabId, url, pushState = true) {
        var info = mainTabInfo[tabId] || mainTabInfo['Documents'];
        document.getElementById('sectionHeading').textContent = info.heading;
        document.getElementById('sectionDescription').textContent = info.description;
        document.title = info.heading + ' - CyberPulse Admin Portal';

        // Deactivate all main tabs and panes
        document.querySelectorAll('.main-tab-btn').forEach(btn => btn.classList.remove('active'));
        var currentActivePane = document.querySelector('.main-pane-content.active');
        
        // Highlight clicked tab
        document.getElementById('main-tab-' + tabId).classList.add('active');

        var newPane = document.getElementById('main-pane-' + tabId);

        if (currentActivePane && currentActivePane !== newPane) {
            // Fade out
            currentActivePane.style.opacity = '0';
            setTimeout(function() {
                currentActivePane.classList.remove('active');
                
                // Fade in new pane
                newPane.classList.add('active');
                // Small delay to allow display:block to apply before animating opacity
                setTimeout(function() {
                    newPane.style.opacity = '1';
                }, 20);
            }, 200); // 200ms matches css transition
        } else if (!currentActivePane) {
            newPane.classList.add('active');
            newPane.style.opacity = '1';
        }

        // Update URL
        if (pushState && url) {
            history.pushState({ tabId: tabId }, '', url);
        }
    }

    // Handle back/forward buttons
    window.addEventListener('popstate', function(e) {
        if (e.state && e.state.tabId) {
            var urls = {
                'Documents': '@Url.Action("Documents", "Quality")',
                'Announcements': '@Url.Action("Announcements", "Quality")',
                'Certificate': '@Url.Action("Certificate", "Quality")'
            };
            switchMainTab(e.state.tabId, urls[e.state.tabId] || urls['Documents'], false);
        } else {
            // Default based on url
            var path = window.location.pathname.toLowerCase();
            if (path.indexOf('/announcements') > -1) {
                switchMainTab('Announcements', null, false);
            } else if (path.indexOf('/certificate') > -1) {
                switchMainTab('Certificate', null, false);
            } else {
                switchMainTab('Documents', null, false);
            }
        }
    });


    // --- Document Inner Tab Switching ---
    var activeDocTabKey = '@activeDocTab';
    var docTabMapping = {
        'QualityManual': 'QualityManual',
        'QualitySystemProcedure': 'QualitySystemProcedure',
        'QualityStandardGuidelines': 'QualityStandardGuidelines',
        'TemplateFormChecklist': 'TemplateFormChecklist'
    };

    // Quality Certificate accepts PDFs and images only (also enforced server-side).
    var certificateAllowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];

    function validateCertificateFiles(input) {
        var rejected = Array.from(input.files || []).filter(function (f) {
            var ext = f.name.split('.').pop().toLowerCase();
            return certificateAllowedExtensions.indexOf(ext) === -1;
        }).map(function (f) { return f.name; });

        if (rejected.length > 0) {
            alert('Only PDF or image files (.pdf, .jpg, .jpeg, .png) can be uploaded to Quality Certificate.\n\nRejected: ' + rejected.join(', '));
            input.value = '';
            return false;
        }
        return true;
    }

    function showDocTab(tabKey) {
        document.querySelectorAll('.tab-pane-content').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.quality-tab-btn').forEach(b => b.classList.remove('active'));
        
        var pane = document.getElementById('pane-' + tabKey);
        if (pane) pane.classList.add('active');
        var btn = document.getElementById('tab-btn-' + tabKey);
        if (btn) btn.classList.add('active');
        
        sessionStorage.setItem('qualityDocActiveTab', tabKey);
    }

    // --- Initialization & Events ---
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Doc Tabs
        var serverTab = docTabMapping[activeDocTabKey] || null;
        var storedTab = sessionStorage.getItem('qualityDocActiveTab');
        var tabToShow = serverTab || storedTab || 'QualityManual';
        showDocTab(tabToShow);

        // Auto-hide alerts
        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(a) {
                a.style.transition = 'opacity 0.5s';
                a.style.opacity = '0';
                setTimeout(function() { a.remove(); }, 500);
            });
        }, 3000);

        // Set initial state for history API if not present
        if (!history.state || !history.state.tabId) {
            history.replaceState({ tabId: '@activeMainTab' }, '', window.location.href);
        }

        // --- Announcements Logic (Checkboxes & Generate JSON) ---
        var selectAll = document.getElementById("selectAll");
        var rowCheckboxes = document.querySelectorAll(".row-checkbox");

        function updateSelectAllState() {
            if (!selectAll || rowCheckboxes.length === 0) return;
            var allChecked = Array.from(rowCheckboxes).every(cb => cb.checked);
            var someChecked = Array.from(rowCheckboxes).some(cb => cb.checked);
            selectAll.checked = allChecked;
            selectAll.indeterminate = someChecked && !allChecked;
        }
        updateSelectAllState();

        if (selectAll) {
            selectAll.addEventListener("change", function () {
                var isChecked = selectAll.checked;
                rowCheckboxes.forEach(cb => cb.checked = isChecked);
            });
        }

        rowCheckboxes.forEach(cb => cb.addEventListener("change", updateSelectAllState));

        var generateForm = document.getElementById("generateJsonForm");
        if (generateForm) {
            generateForm.addEventListener("submit", function (e) {
                e.preventDefault();

                var token = generateForm.querySelector('input[name="__RequestVerificationToken"]').value;
                var allCbs = document.querySelectorAll(".row-checkbox");
                var checkedIds = [];
                var uncheckedIds = [];

                allCbs.forEach(cb => {
                    var id = parseInt(cb.getAttribute("data-id"));
                    if (cb.checked) checkedIds.push(id);
                    else uncheckedIds.push(id);
                });

                var requests = [];

                if (checkedIds.length > 0) {
                    var activateData = new URLSearchParams();
                    activateData.append('__RequestVerificationToken', token);
                    activateData.append('isActive', 'true');
                    checkedIds.forEach(id => activateData.append('ids', id));
                    requests.push(fetch('@Url.Action("BulkToggleActive", "QualityAnnouncement")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: activateData.toString()
                    }));
                }

                if (uncheckedIds.length > 0) {
                    var deactivateData = new URLSearchParams();
                    deactivateData.append('__RequestVerificationToken', token);
                    deactivateData.append('isActive', 'false');
                    uncheckedIds.forEach(id => deactivateData.append('ids', id));
                    requests.push(fetch('@Url.Action("BulkToggleActive", "QualityAnnouncement")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: deactivateData.toString()
                    }));
                }

                Promise.all(requests).then(function() {
                    var tempForm = document.createElement('form');
                    tempForm.method = 'POST';
                    tempForm.action = generateForm.action;
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    tempForm.appendChild(tokenInput);
                    document.body.appendChild(tempForm);
                    tempForm.submit();
                }).catch(function(err) {
                    console.error('Failed to sync announcement states', err);
                    alert('An error occurred while saving selections.');
                });
            });
        }
    });
</script>
}

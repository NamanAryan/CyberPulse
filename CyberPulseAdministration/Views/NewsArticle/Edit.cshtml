@model CyberPulseAdministration.Models.NewsArticle

@{
    ViewBag.Title = "Edit News Article";
}

<!-- Page Header -->
<div class="page-header mb-3">
    <a href="@Url.Action("Index", "NewsArticle")" class="text-secondary text-decoration-none small fw-medium">
        <i class="bi bi-arrow-left me-1"></i>Back to News & Articles
    </a>
    <h2 class="fw-bold mt-2 mb-1">Edit News Article</h2>
    <p class="text-secondary mb-0">Modify an existing news article or event listing.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card p-4">
            @using (Html.BeginForm("Edit", "NewsArticle", null, FormMethod.Post, new { @class = "needs-validation", role = "form", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ID)
                @Html.HiddenFor(m => m.ImageName)
                @Html.HiddenFor(m => m.ImagePath)

                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label small fw-medium mb-1" for="ImageFile">Image Upload</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <div class="mb-2">
                                    <span class="text-muted small d-block mb-1">Current image:</span>
                                    <img src="@Url.Content("~/Uploads/NewsArticles" + Model.ImagePath)" alt="@Model.ImageName" style="max-width: 200px; max-height: 150px; border-radius: 8px; border: 1px solid #dee2e6;" />
                                </div>
                            }
                            <input type="file" class="form-control form-control-sm" id="ImageFile" name="ImageFile" accept="image/*" />
                            <small class="text-muted fst-italic">Leave empty to keep current image. Accepted: JPG, PNG, GIF, WebP</small>
                            <div class="mt-2" id="imagePreviewContainer" style="display: none;">
                                <span class="text-muted small d-block mb-1">New image preview:</span>
                                <img id="imagePreview" src="#" alt="Preview" style="max-width: 200px; max-height: 150px; border-radius: 8px; border: 1px solid #dee2e6;" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label small fw-medium mb-1" for="Type">Type <span class="text-danger">*</span></label>
                                    @Html.DropDownListFor(m => m.Type,
                                        new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "-- Select Type --", Value = "" },
                                            new SelectListItem { Text = "Event", Value = "Event" },
                                            new SelectListItem { Text = "Article", Value = "Article" }
                                        },
                                        new { @class = "form-select form-select-sm" })
                                    @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label small fw-medium mb-1" for="Date">Date <span class="text-danger">*</span></label>
                                    @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control form-control-sm" })
                                    @Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0 small fw-medium" for="Description">Description</label>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-10 small" id="desc-counter">0 / 60</span>
                            </div>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control form-control-sm", rows = 2, placeholder = "Enter a short description of the article or event", maxlength = "60", style = "resize: none;" })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label small fw-medium mb-1" for="URL">URL <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.URL, new { @class = "form-control form-control-sm", placeholder = "https://example.com/article", maxlength = "1024" })
                            @Html.ValidationMessageFor(m => m.URL, "", new { @class = "text-danger small mt-1 d-block" })
                            <small class="text-muted fst-italic">Full URL to the article or event page</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label small fw-medium d-block mb-1">Is Active <span class="text-danger">*</span></label>
                            <div class="form-check form-check-inline me-4">
                                @Html.RadioButtonFor(m => m.IsActive, true, new { @id = "isActiveYes", @class = "form-check-input" })
                                <label class="form-check-label text-secondary small" for="isActiveYes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.IsActive, false, new { @id = "isActiveNo", @class = "form-check-input" })
                                <label class="form-check-label text-secondary small" for="isActiveNo">No</label>
                            </div>
                            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-start gap-3 mt-4 pt-3 border-top">
                    <a href="@Url.Action("Index", "NewsArticle")" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Character counter for Description
        function setupCounter(inputId, counterId, maxLength) {
            var input = document.getElementById(inputId);
            var counter = document.getElementById(counterId);
            if (input && counter) {
                var updateCounter = function () {
                    var currentLength = input.value ? input.value.length : 0;
                    counter.textContent = currentLength + " / " + maxLength;
                    if (currentLength >= maxLength) {
                        counter.classList.remove("bg-secondary-subtle", "text-secondary");
                        counter.classList.add("bg-danger-subtle", "text-danger");
                    } else {
                        counter.classList.add("bg-secondary-subtle", "text-secondary");
                        counter.classList.remove("bg-danger-subtle", "text-danger");
                    }
                };
                input.addEventListener("input", updateCounter);
                updateCounter();
            }
        }

        setupCounter("Description", "desc-counter", 60);

        // Image preview
        var imageInput = document.getElementById('ImageFile');
        if (imageInput) {
            imageInput.addEventListener('change', function () {
                var previewContainer = document.getElementById('imagePreviewContainer');
                var previewImg = document.getElementById('imagePreview');
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewContainer.style.display = 'block';
                    };
                    reader.readAsDataURL(this.files[0]);
                } else {
                    previewContainer.style.display = 'none';
                }
            });
        }
    });
</script>

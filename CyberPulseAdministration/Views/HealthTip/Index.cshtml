@{
    ViewBag.Title = "Health Tips";
    string currentFile = ViewBag.CurrentFile;
    bool hasFile = !string.IsNullOrEmpty(currentFile);
    bool isImage = ViewBag.IsImage != null && (bool)ViewBag.IsImage;
    string textContent = ViewBag.TextContent;
}

<!-- Page Header -->
<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-heart-pulse me-2 text-danger"></i>Health Tips</h2>
        <p class="text-secondary mb-0">Upload a single health tip file (Image or DOC/DOCX). Uploading a new file will replace the existing one.</p>
    </div>
</div>

<div id="js-alert-container"></div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Content Card -->
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="w-50 py-3 ps-4 text-uppercase text-secondary" style="letter-spacing: 0.5px; font-size: 0.85rem;">Name</th>
                            <th class="w-50 py-3 ps-4 text-uppercase text-secondary" style="letter-spacing: 0.5px; font-size: 0.85rem;">Image</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-4 fw-semibold text-dark py-4 fs-6">
                                @(hasFile ? currentFile : "No file uploaded")
                            </td>
                            <td class="ps-4 py-4">
                                @if (hasFile)
                                {
                                    if (isImage)
                                    {
                                        <a href="/Uploads/HealthTip/@currentFile" target="_blank" title="View Full Image" class="d-inline-block shadow-sm rounded overflow-hidden border">
                                            <img src="/Uploads/HealthTip/@currentFile" alt="Health Tip" style="width: 140px; height: 90px; object-fit: cover; background: #f1f5f9; display: block;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-secondary shadow-sm p-3 bg-light border rounded" style="max-height: 90px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;" title="View Full Text">
                                            @textContent
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-secondary shadow-sm" style="width: 140px; height: 90px; display:flex; align-items:center; justify-content:center; background:#f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px;">
                                        <i class="bi bi-file-earmark text-muted fs-3"></i>
                                    </div>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-4 text-center">
            @using (Html.BeginForm("Upload", "HealthTip", FormMethod.Post, new { enctype = "multipart/form-data", id = "healthTipUploadForm", @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                <label class="btn btn-primary px-4 py-2 shadow-sm" for="healthTipFileInput" style="cursor: pointer;">
                    <i class="bi bi-cloud-upload me-2"></i>Upload Health Tips
                    <input type="file" class="d-none" id="healthTipFileInput" name="imageFile" accept=".jpg,.jpeg,.png,.gif,.webp,.doc,.docx" required />
                </label>
            }
            <div class="mt-2 small text-muted fst-italic">Accepted formats: .jpg, .jpeg, .png, .gif, .webp, .doc, .docx</div>
        </div>
    </div>
</div>

@section Scripts {
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        // Auto-hide server alerts
        var alerts = document.querySelectorAll('.alert');
        if (alerts.length > 0) {
            setTimeout(function () {
                alerts.forEach(function (alert) {
                    alert.style.transition = 'opacity 0.5s ease';
                    alert.style.opacity = '0';
                    setTimeout(function () { alert.remove(); }, 500);
                });
            }, 3000);
        }

        // Auto-submit when file selected
        var fileInput = document.getElementById('healthTipFileInput');
        var form = document.getElementById('healthTipUploadForm');

        if (fileInput && form) {
            fileInput.addEventListener('change', function () {
                if (fileInput.files && fileInput.files.length > 0) {
                    form.submit();
                }
            });
        }
    });
</script>
}

